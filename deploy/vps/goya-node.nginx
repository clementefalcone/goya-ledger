limit_req_zone $binary_remote_addr zone=goya_node_per_ip:10m rate=10r/m;
limit_req_zone $server_name zone=goya_node_total:1m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name node.goyaledger.com;

    client_max_body_size 16k;
    limit_req zone=goya_node_per_ip burst=10 nodelay;
    limit_req zone=goya_node_total burst=20 nodelay;
    limit_req_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /api/v1/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080;
    }

    location = /api/v1/store/identities {
        limit_except POST OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8080;
    }

    location ~ "^/api/v1/store/identities/did:goya:[0-9a-f]{128}$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        return 404;
    }
}
