limit_req_zone $binary_remote_addr zone=goya_node_per_ip:10m rate=10r/m;
limit_req_zone $server_name zone=goya_node_total:1m rate=30r/m;

    location = /goya/api/v1/health {
        limit_req zone=goya_node_per_ip burst=10 nodelay;
        limit_req zone=goya_node_total burst=20 nodelay;
        limit_req_status 429;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080/api/v1/health;
    }

    location = /goya/api/v1/store/identities {
        client_max_body_size 16k;
        limit_req zone=goya_node_per_ip burst=10 nodelay;
        limit_req zone=goya_node_total burst=20 nodelay;
        limit_req_status 429;
        limit_except POST OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8080/api/v1/store/identities;
    }

    location ~ "^/goya/api/v1/store/identities/(did:goya:[0-9a-f]{128})$" {
        limit_req zone=goya_node_per_ip burst=10 nodelay;
        limit_req zone=goya_node_total burst=20 nodelay;
        limit_req_status 429;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080/api/v1/store/identities/$1;
    }

    location /goya/ {
        return 404;
    }
